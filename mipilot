  [[ -n $selected_backup ]] || return 1
  selected_settings="${selected_backup%.yaml}.mipilot.json"
  selected_copy="$(mktemp /tmp/mihomo-restore-config.XXXXXX.yaml)" || return 1
  copy_privileged_file_to_temp "$selected_backup" "$selected_copy" || {
    rm -f -- "$selected_copy"
    return 1
  }
  if sudo test -f "$selected_settings"; then
    settings_copy="$(mktemp /tmp/mipilot-restore-config.XXXXXX.json)" || return 1
    copy_privileged_file_to_temp "$selected_settings" "$settings_copy" || {
      rm -f -- "$selected_copy" "$settings_copy"
      return 1
    }
    jq -e '.schema_version == 1' "$settings_copy" >/dev/null || {
      sudo rm -f -- "$selected_copy" "$settings_copy"
      echo "备份中的 MiPilot 配置无效, 未执行恢复."
      return 1
    }
  fi
  run_cancellable_named "正在验证备份配置" 45 \
    sudo -n "$MIHOMO_BIN" -t -d "$CONFIG_DIR" -f "$selected_copy" || {
    sudo rm -f -- "$selected_copy"
    echo "备份配置验证失败, 未执行恢复."
    return 1
  }
  runtime_is_active && was_active=1
  current_backup="$(create_config_backup before-restore)" || {
    sudo rm -f -- "$selected_copy" "$settings_copy"
    return 1
  }
  current_settings="${current_backup%.yaml}.mipilot.json"
  atomic_install_file 600 "$selected_copy" "$CONFIG_FILE" || {
    sudo rm -f -- "$selected_copy" "$settings_copy"
    return 1
  }
  if [[ -n $settings_copy ]]; then
    atomic_install_file 600 "$settings_copy" "$MANAGER_CONFIG_FILE" || {
      atomic_install_file 600 "$current_backup" "$CONFIG_FILE" || true
      sudo rm -f -- "$selected_copy" "$settings_copy"
      return 1
    }
    materialize_mipilot_state || {
      atomic_install_file 600 "$current_backup" "$CONFIG_FILE" || true
      atomic_install_file 600 "$current_settings" "$MANAGER_CONFIG_FILE" || true
      materialize_mipilot_state || true
      sudo rm -f -- "$selected_copy" "$settings_copy"
      return 1
    }
  fi
  sudo rm -f -- "$selected_copy" "$settings_copy"
  if ! apply_runtime_config_if_active "$was_active" 3; then
    atomic_install_file 600 "$current_settings" "$MANAGER_CONFIG_FILE" || true
    materialize_mipilot_state || true
    if rollback_config "$current_backup" "$was_active"; then
      echo "恢复后的配置无法运行, 已自动恢复原配置."
    else
      echo "严重错误: 配置恢复失败且原配置未能自动恢复, 请使用 ${current_backup} 手动处理."
    fi
    return 1
  fi
  if ! reconcile_tun_runtime_state; then
    echo "配置已恢复, 但 TUN 状态同步或旧版端口旁路清理失败."
    return 1
  fi
  sync_mipilot_config_from_state || return 1
  refresh_api_config
  if (( was_active == 1 )) && ! restore_mipilot_selections; then
    echo "配置备份已恢复, 但保存的节点或策略组选择未能完全恢复."
    return 1
  fi
  echo "配置备份已恢复."
  (( was_active == 0 )) && echo "Mihomo 当前未运行, 恢复的配置将在下次启动时生效."
}

