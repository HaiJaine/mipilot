apply_rule_selector_to_config() {
  local input_file="$1"
  local output_file="$2"
  local source_policy="${3:-}"
  local selected_group
  local current_policy
  local without_selector
  local refs_file
  local groups_file
  local definitions_file
  local with_selector
  local group_name
  local status=0
  local source_included=0
  local current_included=0
  local source_available=0

  without_selector="$(mktemp /tmp/mihomo-rule-selector-base.XXXXXX.yaml)" || return 1
  refs_file="$(mktemp /tmp/mihomo-rule-selector-refs.XXXXXX)" || {
    rm -f -- "$without_selector"
    return 1
  }
  groups_file="$(mktemp /tmp/mihomo-rule-selector-groups.XXXXXX)" || {
    rm -f -- "$without_selector" "$refs_file"
    return 1
  }
  definitions_file="$(mktemp /tmp/mihomo-rule-selector-definition.XXXXXX.json)" || {
    rm -f -- "$without_selector" "$refs_file" "$groups_file"
    return 1
  }
  with_selector="$(mktemp /tmp/mihomo-rule-selector-config.XXXXXX.yaml)" || {
    rm -f -- "$without_selector" "$refs_file" "$groups_file" "$definitions_file"
    return 1
  }

  selected_group="$(sudo jq -r '.rule_selection.group // empty' "$MANAGER_CONFIG_FILE" 2>/dev/null || true)"
  if config_rules_reference_policy "$input_file" "$RULE_SELECTOR_GROUP"; then
    current_policy="$RULE_SELECTOR_GROUP"
  elif [[ -n $selected_group ]] && config_rules_reference_policy "$input_file" "$selected_group"; then
    current_policy="$selected_group"
  elif [[ -n $source_policy ]] && config_rules_reference_policy "$input_file" "$source_policy"; then
    current_policy="$source_policy"
  else
    current_policy="$(config_match_policy "$input_file")"
  fi
  if [[ $source_policy == DIRECT || $source_policy == REJECT || $source_policy == PASS ]] ||
     config_rules_reference_policy "$input_file" "$source_policy" ||
     parent_group_has_child "$input_file" "$RULE_SELECTOR_GROUP" "$source_policy"; then
    source_available=1
  fi

  render_without_region_group "$input_file" "$without_selector" "$RULE_SELECTOR_GROUP" || status=$?
  : >"$refs_file"
  : >"$groups_file"
  if (( status == 0 )); then
    while IFS= read -r group_name; do
      [[ -n $group_name ]] || continue
      [[ $group_name == "$RULE_SELECTOR_GROUP" || $group_name == "$REGION_MANAGED_PARENT" ]] && continue
      printf '%s\n' "$group_name" >>"$groups_file"
      [[ $group_name == "$source_policy" ]] && source_included=1
      [[ $group_name == "$current_policy" ]] && current_included=1
    done < <(list_config_group_names "$without_selector")
    if [[ -n $source_policy && $source_policy != "$RULE_SELECTOR_GROUP" ]] &&
       (( source_included == 0 && source_available == 1 )); then
      printf '%s\n' "$source_policy" >>"$groups_file"
      [[ $current_policy == "$source_policy" ]] && current_included=1
    fi
    if [[ -n $current_policy && $current_policy != "$RULE_SELECTOR_GROUP" ]] && (( current_included == 0 )); then
      printf '%s\n' "$current_policy" >>"$groups_file"
    fi
    if [[ ! -s $groups_file ]]; then
      printf '%s\n' DIRECT >"$groups_file"
    fi
    jq -Rn --arg name "$RULE_SELECTOR_GROUP" '
      [inputs | select(length > 0)] as $groups
      | [{name: $name, type: "select", proxies: $groups}]
    ' <"$groups_file" >"$definitions_file" || status=$?
  fi
  if (( status == 0 )); then
    render_region_overlay "$without_selector" "$with_selector" "$refs_file" "$definitions_file" || status=$?
  fi
  if (( status == 0 )); then
    if [[ $current_policy == "$RULE_SELECTOR_GROUP" ]]; then
      mv -f -- "$with_selector" "$output_file" || status=$?
    elif [[ -z $current_policy ]]; then
      # The input needs sudo; the caller-owned output path intentionally does not.
      # shellcheck disable=SC2024
      sudo env MIPILOT_RULE_OUTLET="$RULE_SELECTOR_GROUP" \
        "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval '
          .rules = ((.rules // []) + ["MATCH," + strenv(MIPILOT_RULE_OUTLET)])
        ' "$with_selector" >"$output_file" || status=$?
    else
      render_rule_strategy_selection "$with_selector" "$output_file" "$current_policy" "$RULE_SELECTOR_GROUP" || status=$?
    fi
  fi

  rm -f -- "$without_selector" "$refs_file" "$groups_file" "$definitions_file" "$with_selector"
  return "$status"
}

delete_managed_region_group() {
  local name
  local candidate_state
  local base_config
  local parent
  local selected_group
  local previous_settings=""
  local status

  select_managed_region_record "选择要删除的 MiPilot 策略组:" || return
  IFS=';' read -r _ name _ _ <<<"$SELECTED_REGION_RECORD"
  read_yes_no_or_back "确认删除策略组 ${name}? [y/N] (Enter=否, Esc返回): " no
  status=$?
  if (( status != 0 )); then return "$status"; fi
  [[ $CONFIRM_RESULT == yes ]] || { echo "已取消删除, 配置未改变."; return 130; }

  candidate_state="$(mktemp /tmp/mihomo-region-delete-state.XXXXXX)" || return 1
  base_config="$(mktemp /tmp/mihomo-region-delete-config.XXXXXX.yaml)" || {
    rm -f -- "$candidate_state"
    return 1
  }
  # The input needs sudo; the caller-owned output path intentionally does not.
  # shellcheck disable=SC2024
  sudo awk -F';' -v target="$name" '$2 != target && NF >= 3' "$REGION_STATE_FILE" >"$candidate_state" || {
    rm -f -- "$candidate_state" "$base_config"
    return 1
  }
  parent="$(sudo jq -r '.rule_selection.parent // empty' "$MANAGER_CONFIG_FILE" 2>/dev/null || true)"
  selected_group="$(sudo jq -r '.rule_selection.group // empty' "$MANAGER_CONFIG_FILE" 2>/dev/null || true)"
  if [[ $selected_group == "$name" ]]; then
    previous_settings="$(mktemp /tmp/mipilot-region-delete-settings.XXXXXX.json)" || {
      rm -f -- "$candidate_state" "$base_config"
      return 1
    }
    copy_privileged_file_to_temp "$MANAGER_CONFIG_FILE" "$previous_settings" || {
      sudo rm -f -- "$previous_settings"
      rm -f -- "$candidate_state" "$base_config"
      return 1
    }
    if ! update_mipilot_selection rule "$parent" "$parent"; then
      sudo rm -f -- "$previous_settings"
      rm -f -- "$candidate_state" "$base_config"
      echo "无法先切换到订阅规则入口, 策略组未删除."
      return 1
    fi
  fi
  render_without_region_group "$CONFIG_FILE" "$base_config" "$name" || {
    if [[ -n $previous_settings ]]; then
      atomic_install_file 600 "$previous_settings" "$MANAGER_CONFIG_FILE" || true
      materialize_mipilot_state || true
    fi
    sudo rm -f -- "$previous_settings"
    rm -f -- "$candidate_state" "$base_config"
    return 1
  }
  apply_region_group_state "$candidate_state" region-delete "策略组已删除: ${name}" "$base_config"
  status=$?
  if (( status != 0 )) && [[ -n $previous_settings ]]; then
    if ! atomic_install_file 600 "$previous_settings" "$MANAGER_CONFIG_FILE" ||
       ! materialize_mipilot_state; then
      echo "严重错误: 删除失败后无法恢复原策略组选择."
    fi
  fi
  sudo rm -f -- "$previous_settings"
  rm -f -- "$candidate_state" "$base_config"
  return "$status"
}

