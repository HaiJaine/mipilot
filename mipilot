render_mode_config() {
  local input_file="$1"
  local output_file="$2"
  local mode="$3"

  [[ $mode == rule || $mode == global || $mode == direct ]] || return 1

  # The input needs sudo; the caller-owned output path intentionally does not.
  # shellcheck disable=SC2024
  sudo awk -v selected_mode="$mode" '
    /^mode:[[:space:]]*/ {
      if (!mode_seen) {
        print "mode: " selected_mode
        mode_seen = 1
      }
      next
    }
    { print }
    END {
      if (!mode_seen) {
        print ""
        print "mode: " selected_mode
      }
    }
  ' "$input_file" >"$output_file"
}

profile_store_selected_value() {
  sudo awk '
    /^profile:[[:space:]]*(#.*)?$/ {
      in_profile = 1
      next
    }
    in_profile && /^[^[:space:]#][^:]*:/ {
      exit
    }
    in_profile && /^[[:space:]]+store-selected:[[:space:]]*/ {
      value = $0
      sub(/^[[:space:]]+store-selected:[[:space:]]*/, "", value)
      sub(/[[:space:]]*#.*/, "", value)
      gsub(/[[:space:]]/, "", value)
      print tolower(value)
      found = 1
      exit
    }
    END {
      if (!found) print "false"
    }
  ' "$CONFIG_FILE"
}

render_store_selected_config() {
  local input_file="$1"
  local output_file="$2"

  # The input needs sudo; the caller-owned output path intentionally does not.
  # shellcheck disable=SC2024
  sudo awk '
    function finish_profile() {
      if (!store_selected_seen) print "  store-selected: true"
    }

    {
      if (in_profile && $0 ~ /^[^[:space:]#][^:]*:/) {
        finish_profile()
        in_profile = 0
      }

      if ($0 ~ /^profile:[[:space:]]*(#.*)?$/) {
        profile_found = 1
        in_profile = 1
        store_selected_seen = 0
        print
        next
      }

      if ($0 ~ /^profile:[[:space:]]*[^[:space:]#]/) {
        print "不支持行内写法的 profile 配置, 请先改为多行 YAML." > "/dev/stderr"
        fatal = 1
        exit 42
      }

      if (in_profile && $0 ~ /^[[:space:]]+store-selected:[[:space:]]*/) {
        print "  store-selected: true"
        store_selected_seen = 1
        next
      }

      print
    }

    END {
      if (fatal) exit 42
      if (in_profile) finish_profile()
      if (!profile_found) {
        print ""
        print "profile:"
        print "  store-selected: true"
      }
    }
  ' "$input_file" >"$output_file"
}

ensure_store_selected() {
  local temporary
