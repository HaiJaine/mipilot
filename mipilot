verify_tun_runtime_network() {
  local config_response
  local ssh_client=""
  local ssh_server=""
  local ssh_route=""
  local ssh_route_device=""
  local tun_device=""
  local default_route_count

  refresh_api_config
  [[ -n $API ]] || return 1
  config_response="$(api_quick "${API}/configs")" || return 1
  jq -e '.tun.enable == true' <<<"$config_response" >/dev/null || return 1
  ip route get 1.1.1.1 >/dev/null 2>&1 || return 1

  default_route_count="$(ip -4 route show default 2>/dev/null | awk 'NF { count++ } END { print count + 0 }')"
  if (( default_route_count > 1 )); then
    echo "提示: 检测到 ${default_route_count} 条 IPv4 默认路由, 当前由 Mihomo 自动识别出口."
    echo "多公网出口环境仍需确认实际流量和回程接口符合预期."
  fi

  if [[ -n ${SSH_CONNECTION:-} ]]; then
    read -r ssh_client _ ssh_server _ <<<"$SSH_CONNECTION"
    if [[ $ssh_client == *:* ]]; then
      ssh_route="$(ip -6 route get "$ssh_client" from "$ssh_server" 2>/dev/null)"
    else
      ssh_route="$(ip -4 route get "$ssh_client" from "$ssh_server" 2>/dev/null)"
    fi
    if [[ -z $ssh_client || -z $ssh_server || -z $ssh_route ]]; then
      echo "警告: 无法解析当前 SSH 客户端 ${ssh_client} 的回程路由."
      echo "TUN 已保持开启, 请通过当前会话或备用管理通道确认连接正常."
    else
      ssh_route_device="$(awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }' <<<"$ssh_route")"
      tun_device="$(jq -r '.tun.device // empty' <<<"$config_response")"
      if [[ -n $tun_device && $ssh_route_device == "$tun_device" ]]; then
        echo "警告: 当前 SSH 客户端 ${ssh_client} 的回程指向 TUN 网卡: ${ssh_route}"
        echo "TUN 已保持开启, 请确认当前 SSH 会话和实际服务访问正常."
      else
        echo "SSH 回程检查通过: ${ssh_client} 经 ${ssh_route_device:-系统路由} 返回."
      fi
    fi
  fi

  if curl -4 -fsS --noproxy '*' --connect-timeout 5 --max-time 10 \
       -o /dev/null https://cp.cloudflare.com/generate_204; then
    echo "TUN 出站联网检查通过."
  else
    echo "警告: TUN 和系统路由已建立, 但公网连通性探测失败."
    echo "这可能由节点、DNS、防火墙或探测地址不可达造成, 请立即验证实际访问和 SSH 回程."
  fi
}

apply_tun_setting() {
  local enabled="$1"
  local label="$2"
  local temporary
  local backup
  local status
  local previous_state
  local had_state=0
  local was_active=0

  ensure_sudo_access || return 1
  runtime_is_active && was_active=1
  temporary="$(mktemp /tmp/mihomo-tun-config.XXXXXX.yaml)" || return
  backup=""

  echo "[1/5] 正在生成 TUN 配置..."
  if ! render_tun_config "$CONFIG_FILE" "$temporary" "$enabled"; then
    rm -f -- "$temporary"
    echo "生成 TUN 配置失败, 现有配置未改变."
    return 1
  fi

  echo "[2/5] 验证配置"
  run_cancellable_named "正在验证 TUN 配置" 35 \
    sudo -n "$MIHOMO_BIN" -t -d "$CONFIG_DIR" -f "$temporary"
  status=$?
  if (( status == 130 )); then
    rm -f -- "$temporary"
    return 130
  fi
  if (( status != 0 )); then
    rm -f -- "$temporary"
    echo "配置验证失败, TUN 状态未改变."
    return 1
  fi

  echo "[3/5] 正在备份并替换配置, 此阶段不可中断..."
  backup="$(create_config_backup tun)" || {
    rm -f -- "$temporary"
    return 1
  }
  previous_state="$(mktemp /tmp/mihomo-tun-state-previous.XXXXXX)" || {
    rm -f -- "$temporary"
    return 1
  }
  if sudo test -f "$TUN_STATE_FILE"; then
    had_state=1
    copy_privileged_file_to_temp "$TUN_STATE_FILE" "$previous_state" || {
      rm -f -- "$temporary"
      sudo rm -f -- "$previous_state"
      return 1
    }
  fi
  if ! save_tun_state "$enabled"; then
    rm -f -- "$temporary"
    sudo rm -f -- "$previous_state"
    echo "无法保存 TUN 状态, 现有配置未改变."
    return 1
  fi
  atomic_install_file 600 "$temporary" "$CONFIG_FILE" || {
    restore_optional_managed_file "$previous_state" "$had_state" "$TUN_STATE_FILE" || true
    sync_mipilot_config_from_state || true
    sudo rm -f -- "$previous_state"
    rm -f -- "$temporary"
    return 1
  }
  rm -f -- "$temporary"

  if (( was_active == 0 )); then
    run_tun_routing_action reconcile || echo "警告: 旧版 MiPilot TUN 路由规则未能完成清理."
    sudo rm -f -- "$previous_state"
    cleanup_legacy_tun_bypass || echo "警告: 旧版TUN端口旁路规则未完全清理."
    echo "TUN 模式已配置为${label}, Mihomo 当前未运行, 将在下次启动时生效."
    echo "备份文件: ${backup}"
    return 0
  fi

  echo "[4/5] 重启 Mihomo"
  if ! restart_mihomo_with_progress; then
    if rollback_config "$backup"; then
      restore_optional_managed_file "$previous_state" "$had_state" "$TUN_STATE_FILE" || true
      sync_mipilot_config_from_state || true
      echo "Mihomo 启动失败, TUN 状态已回滚."
    else
      echo "Mihomo 启动失败且自动回滚未完成, 请立即检查 ${backup}."
    fi
    sudo rm -f -- "$previous_state"
    return 1
  fi

  echo "[5/5] 等待 Mihomo 服务稳定"
  if ! run_blocking "正在等待 Mihomo 服务稳定" 15 wait_for_mihomo_stable 2; then
    if rollback_config "$backup"; then
      restore_optional_managed_file "$previous_state" "$had_state" "$TUN_STATE_FILE" || true
      sync_mipilot_config_from_state || true
      echo "Mihomo 未能稳定运行, TUN 状态已回滚."
    else
      echo "Mihomo 未稳定运行且自动回滚未完成, 请立即检查 ${backup}."
    fi
    sudo rm -f -- "$previous_state"
    return 1
  fi
  if [[ $enabled == true ]] && ! verify_tun_runtime_network; then
    if rollback_config "$backup"; then
      restore_optional_managed_file "$previous_state" "$had_state" "$TUN_STATE_FILE" || true
      sync_mipilot_config_from_state || true
      echo "TUN 路由或当前 SSH 回程检查失败, 已自动回滚."
    else
      echo "TUN 网络检查失败且自动回滚未完成, 请立即检查 ${backup}."
    fi
    sudo rm -f -- "$previous_state"
    return 1
  fi
  sudo rm -f -- "$previous_state"

  cleanup_legacy_tun_bypass || echo "警告: 旧版TUN端口旁路规则未完全清理."

  refresh_api_config
  echo "TUN 模式已${label}."
  echo "备份文件: ${backup}"
}

enable_tun_mode() {
  local status

  if [[ ! -c /dev/net/tun ]]; then
    echo "系统不存在 /dev/net/tun, 当前环境无法开启 TUN 模式."
    return 1
  fi

  echo "开启 TUN 会修改服务器路由和 DNS, 远程 SSH 连接可能受到影响."
  echo "当前终端代理: $(proxy_status_label)"
  show_tun_network_warnings

  if [[ ${MIHOMO_PROXY_ENABLED:-0} == 1 || -n ${http_proxy:-} || -n ${https_proxy:-} || -n ${all_proxy:-} || -n ${HTTP_PROXY:-} || -n ${HTTPS_PROXY:-} || -n ${ALL_PROXY:-} ]]; then
    read_yes_no_or_back "检测到终端代理已开启, 是否先关闭? [Y/n] (Enter=是, Esc返回): " yes
    status=$?
    if (( status == 130 )); then return 130; fi
    if (( status != 0 )); then return 1; fi
    if [[ $CONFIRM_RESULT == yes ]]; then
      disable_system_proxy || return
    else
      echo "将保留当前终端代理设置."
    fi
    echo
  fi

  read_yes_no_or_back "确认开启 TUN? [y/N] (Enter=否, Esc返回): " no
  status=$?
  if (( status == 130 )); then return 130; fi
  if (( status != 0 )); then return 1; fi
  if [[ $CONFIRM_RESULT != yes ]]; then
    echo "已取消开启 TUN."
    return 130
  fi

  apply_tun_setting true "开启"
}

disable_tun_mode() {
  local status

  read_yes_no_or_back "确认关闭 TUN? [y/N] (Enter=否, Esc返回): " no
  status=$?
  if (( status == 130 )); then return 130; fi
  if (( status != 0 )); then return 1; fi
  if [[ $CONFIRM_RESULT != yes ]]; then
    echo "已取消关闭 TUN."
    return 130
  fi

  apply_tun_setting false "关闭"
}

