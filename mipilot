  migrate_legacy_backups || true
  cleanup_expired_rollbacks || true
  cleanup_legacy_tun_bypass || echo "警告: 旧版TUN端口旁路未完全清理."
  refresh_api_config
  sync_proxy_state
  main_menu || status=$?
  unset API_SECRET
  release_manager_lock
  return "$status"
}

entrypoint() {
  local action="${1:-}"
  local state

  if should_reject_sudo_invocation "$action" "$EUID" "${SUDO_USER:-}"; then
    echo "请不要以root或sudo运行 mipilot 的交互流程."
    echo "请以普通用户执行, 程序会在需要时请求 sudo 权限."
    return 1
  fi

  if [[ -z $action || $action == --install || $action == --menu ]]; then
    require_interactive_terminal || return 1
  fi

  case "$action" in
    --version|-v)
      echo "mipilot ${MANAGER_VERSION}"
      return 0
      ;;
    --cleanup)
      ensure_sudo_access || return 1
      acquire_manager_lock || return 1
      cleanup_expired_rollbacks
      local cleanup_status=$?
      release_manager_lock
      return "$cleanup_status"
      ;;
    --reconcile-tun-routing)
      ensure_sudo_access || return 1
      run_tun_routing_action reconcile
      return $?
      ;;
    --remove-tun-routing)
      ensure_sudo_access || return 1
      run_tun_routing_action remove
      return $?
      ;;
    --reconcile-tun-routing-unlocked)
      ensure_sudo_access || return 1
      reconcile_tun_routing_rules
      return $?
      ;;
    --remove-tun-routing-unlocked)
      ensure_sudo_access || return 1
      remove_tun_routing_rules
      return $?
      ;;
    --doctor)
      ensure_sudo_access || return 1
      show_network_compatibility_report
      return $?
      ;;
    --menu)
      main
      return $?
      ;;
    ""|--install) ;;
    *)
      echo "未知参数: ${action}"
      echo "用法: mipilot [--version|--doctor|--cleanup]"
      return 1
      ;;
  esac

  ensure_utf8_input_locale || return 1
  ensure_sudo_access || return 1
  state="$(detect_install_state)"
  if [[ $state == managed ]]; then
    if [[ $SCRIPT_PATH == "$MANAGER_INSTALLED_SCRIPT" ]]; then
      main
    else
      acquire_manager_lock || return 1
      offer_local_manager_upgrade
      local status=$?
      release_manager_lock
      (( status == 0 )) || return "$status"
      echo "Mihomo 已安装. 请执行:"
      echo "  source ~/.bashrc"
      echo "  mipilot"
    fi
  else
    check_supported_platform || return 1
    ensure_install_dependencies || return $?
    acquire_manager_lock || return 1
    run_install_wizard "$state"
    local status=$?
    release_manager_lock
    return "$status"
  fi
}

if [[ ${MIPILOT_TESTING:-0} != 1 ]]; then
  if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    entrypoint "$@"
  elif [[ ${1:-} == --menu ]]; then
    entrypoint --menu
  fi
fi
