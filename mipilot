render_region_overlay() {
  local input_file="$1"
  local output_file="$2"
  local refs_file="$3"
  local definitions_file="$4"

  [[ ! -s $refs_file ]] || {
    echo "结构化策略组不支持隐式挂载到其他策略组." >&2
    return 1
  }
  yaml_processor_available || return 1
  sudo "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval-all '
    select(fileIndex == 0) as $base
    | select(fileIndex == 1) as $defs
    | ($defs | map(.name)) as $names
    | $base
    | .["proxy-groups"] =
        (((.["proxy-groups"] // [])
          | map(select(.name as $name | $names | any_c(. == $name) | not)))
         + $defs)
  ' "$input_file" "$definitions_file" >"$output_file"
}

render_managed_rule_outlet() {
  local input_file="$1"
  local output_file="$2"
  local current_policy

  current_policy="$(config_match_policy "$input_file")" || return 1
  if [[ -n $current_policy ]]; then
    render_rule_strategy_selection "$input_file" "$output_file" "$current_policy" "$REGION_MANAGED_PARENT"
    return
  fi
  sudo env MIPILOT_RULE_OUTLET="$REGION_MANAGED_PARENT" "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval '
    .rules = ((.rules // []) + ["MATCH," + strenv(MIPILOT_RULE_OUTLET)])
  ' "$input_file" >"$output_file"
}

render_without_region_group() {
  local input_file="$1"
  local output_file="$2"
  local removed_group="$3"

  yaml_processor_available || return 1
  sudo env MIPILOT_REMOVED_GROUP="$removed_group" "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval '
    del(.["proxy-groups"][]? | select(.name == strenv(MIPILOT_REMOVED_GROUP)))
    | (.["proxy-groups"][]? | select(.proxies != null) | .proxies)
        |= map(select(. != strenv(MIPILOT_REMOVED_GROUP)))
  ' "$input_file" >"$output_file"
}

