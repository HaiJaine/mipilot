region_group_rules_current() {
  local config_file="$1"
  local state_file="$2"
  local refs_file
  local definitions_file
  local actual_file
  local status=0

  refs_file="$(mktemp /tmp/mihomo-region-check-refs.XXXXXX)" || return 1
  definitions_file="$(mktemp /tmp/mihomo-region-check-definitions.XXXXXX.json)" || {
    rm -f -- "$refs_file"
    return 1
  }
  actual_file="$(mktemp /tmp/mihomo-region-check-actual.XXXXXX.json)" || {
    rm -f -- "$refs_file" "$definitions_file"
    return 1
  }
  prepare_region_overlay "$config_file" "$state_file" "$refs_file" "$definitions_file" || status=$?
  if (( status == 0 )); then
    sudo "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval -o=json '.["proxy-groups"] // []' "$config_file" >"$actual_file" || status=$?
  fi
  if (( status == 0 )); then
    jq -e --slurpfile expected "$definitions_file" '
      ($expected[0] | map(.name)) as $names
      | ([.[] | select(.name as $name | $names | index($name))] == $expected[0])
    ' "$actual_file" >/dev/null || status=$?
