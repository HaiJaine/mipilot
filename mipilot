create_custom_region_group() {
  local response="$1"
  local group_name
  local selections
  local entries=()
  local entry
  local number
  local number_value
  local selected_code
  local selected_pattern
  local combined_pattern=""
  local candidate_state
  local nodes_file
  local count
  local status
  local code
  local name
  local pattern
  local group_mode
  local mode_label
  local index=1
  local region_codes=()
  local region_patterns=()
  echo "可组合的地区:"
  while IFS=';' read -r code name pattern; do
    [[ -n $code && -n $name && -n $pattern ]] || continue
    printf ' %2d) %s\n' "$index" "$name"
    region_codes+=("$code")
    region_patterns+=("$pattern")
    index=$((index + 1))
  done < <(region_specs)
  read_line_or_back "输入地区编号, 多个用逗号分隔(例如 3,4; Esc返回): "
  status=$?
  if (( status != 0 )); then return "$status"; fi
  selections="${INPUT_LINE//$'\r'/}"
  selections="${selections//，/,}"
  selections="$(trim_input_whitespace "$selections")"
  [[ -n $selections ]] || return 130
  if [[ ! $selections =~ ^[0-9]+[[:space:]]*(,[[:space:]]*[0-9]+[[:space:]]*)*$ ]]; then
    echo "地区编号格式无效, 请使用逗号分隔, 例如 3,4."
    return 1
  fi

  declare -A selected_regions=()
  IFS=',' read -ra entries <<<"$selections"
  for entry in "${entries[@]}"; do
    number="$(trim_input_whitespace "$entry")"
    number_value=$((10#$number))
    if (( number_value < 1 || number_value > ${#region_codes[@]} )); then
      echo "地区编号无效: ${entry}"
      return 1
    fi
    selected_code="${region_codes[$((number_value - 1))]}"
    [[ -n ${selected_regions[$selected_code]+present} ]] && continue
    selected_regions["$selected_code"]=1
    selected_pattern="${region_patterns[$((number_value - 1))]}"
    if [[ -n $combined_pattern ]]; then combined_pattern+="|"; fi
    combined_pattern+="$selected_pattern"
  done
  [[ -n $combined_pattern ]] || return 1

  read_line_or_back "自定义策略组名称(将自动添加 MiPilot- 前缀): "
  status=$?
  if (( status != 0 )); then return "$status"; fi
  group_name="$(trim_input_whitespace "$INPUT_LINE")"
  [[ -n $group_name ]] || return 130
  if display_text_has_control_characters "$group_name"; then
    echo "策略组名称不能包含制表符或其他控制字符."
    return 1
  fi
  if [[ $group_name == *';'* || $group_name == *','* || $group_name == *'"'* || $group_name == *'\\'* ]]; then
    echo "策略组名称不能包含分号、逗号、双引号、反斜杠或换行."
    return 1
  fi
  [[ $group_name == MiPilot-* ]] || group_name="MiPilot-${group_name}"
  if sudo awk -F';' -v target="$group_name" '$2 == target { found = 1 } END { exit(found ? 0 : 1) }' "$REGION_STATE_FILE" 2>/dev/null; then
    echo "策略组已经存在: ${group_name}"
    return 1
  fi
  if config_has_group "$CONFIG_FILE" "$group_name"; then
    echo "当前订阅已经存在同名策略组: ${group_name}"
    echo "请使用其他名称, 避免把订阅策略组误认为 MiPilot 自定义策略组."
    return 1
  fi

  choose_item "选择策略类型:" \
    "自动测速 - 定期检测并选择延迟合适的节点" \
    "故障回退 - 优先节点不可用时自动切换" \
    "负载均衡 - 将不同连接分配到多个节点" \
    "手动选择 - 由用户固定选择组内节点" || return
  case "$SELECTED" in
    自动测速*) group_mode="url-test"; mode_label="自动测速" ;;
    故障回退*) group_mode="fallback"; mode_label="故障回退" ;;
    负载均衡*) group_mode="load-balance"; mode_label="负载均衡" ;;
    手动选择*) group_mode="select"; mode_label="手动选择" ;;
    *)
      echo "无法识别策略类型."
      return 1
      ;;
  esac

  nodes_file="$(mktemp /tmp/mihomo-custom-group-nodes.XXXXXX)" || return 1
  jq -r '
    .proxies
    | to_entries[]
    | select(.value.all == null)
    | select(.key != "DIRECT" and .key != "REJECT" and .key != "PASS")
    | select(.key | test("剩余流量|流量剩余|到期时间|过期时间|套餐到期|重置时间|流量重置|Traffic|Expire|Expiration|Bandwidth|Reset"; "i") | not)
    | .key
  ' <<<"$response" >"$nodes_file"
  count="$(grep -Eic -- "$combined_pattern" "$nodes_file" || true)"
  rm -f -- "$nodes_file"
  if (( count == 0 )); then
    echo "当前订阅没有匹配到所选地区的实际节点, 未创建策略组."
    return 1
  fi

  echo "策略组: ${group_name}"
  echo "包含节点数: ${count}"
  echo "策略类型: ${mode_label}"
  read_yes_no_or_back "确认创建策略组? [y/N] (Enter=否, Esc返回): " no
  status=$?
  if (( status != 0 )); then return "$status"; fi
  [[ $CONFIRM_RESULT == yes ]] || { echo "已取消创建, 配置未改变."; return 130; }

  candidate_state="$(mktemp /tmp/mihomo-custom-group-state.XXXXXX)" || return 1
  if sudo test -f "$REGION_STATE_FILE"; then
    # shellcheck disable=SC2024
    sudo cat "$REGION_STATE_FILE" >"$candidate_state" || {
      rm -f -- "$candidate_state"
      return 1
    }
  fi
  printf 'custom-%s;%s;%s;%s\n' "$(date +%s%N)" "$group_name" "$combined_pattern" "$group_mode" >>"$candidate_state"
  apply_region_group_state "$candidate_state" custom-group "自定义策略组已创建: ${group_name}"
  status=$?
  rm -f -- "$candidate_state"
  return "$status"
}

manage_region_groups() {
