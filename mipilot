region_exclude_pattern() {
  printf '%s\n' '剩余流量|流量剩余|到期时间|过期时间|套餐到期|重置时间|流量重置|Traffic|Expire|Expiration|Bandwidth|Reset'
}

yaml_processor_available() {
  [[ -x $YQ_BIN ]] && "$YQ_BIN" --version 2>/dev/null | grep -Fq "version v${YQ_VERSION}"
}

config_has_group() {
  local config_file="$1"
  local group_name="$2"

  yaml_processor_available || return 1
  sudo env MIPILOT_GROUP_NAME="$group_name" "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval -r \
    '.["proxy-groups"][]? | select(.name == strenv(MIPILOT_GROUP_NAME)) | .name' \
    "$config_file" | grep -Fqx -- "$group_name"
}

list_config_group_names() {
  local config_file="$1"

  yaml_processor_available || return 1
  sudo "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval -r '.["proxy-groups"][]?.name // ""' "$config_file" | sed '/^$/d'
}

list_config_selector_names() {
  local config_file="$1"

  yaml_processor_available || return 1
  sudo "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval -r \
    '.["proxy-groups"][]? | select((.type // "") == "select") | .name // ""' \
    "$config_file" | sed '/^$/d'
}

list_config_rule_policy_names() {
  local config_file="$1"

  yaml_processor_available || return 1
  sudo "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval -r '
    .["rules"][]?
    | select(tag == "!!str")
    | split(",")
    | (
        (select((.[-1] | downcase | sub("^\\s+|\\s+$"; "")) == "no-resolve") | .[-2]),
        (select((.[-1] | downcase | sub("^\\s+|\\s+$"; "")) != "no-resolve") | .[-1])
      )
    | sub("^\\s+|\\s+$"; "")
    | sub("^[\"\\x27]|[\"\\x27]$"; "")
    | select(. != "" and . != "DIRECT" and . != "REJECT" and . != "PASS")
  ' "$config_file"
}

config_match_policy() {
  local config_file="$1"

  yaml_processor_available || return 1
  sudo "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval -r '
    .["rules"][]?
    | select(tag == "!!str")
    | select(test("^\\s*MATCH\\s*,"))
    | split(",")[1]
    | sub("^\\s+|\\s+$"; "")
    | sub("^[\"\\x27]|[\"\\x27]$"; "")
  ' "$config_file" | tail -n 1
}

config_rules_reference_policy() {
  local config_file="$1"
  local target="$2"

  yaml_processor_available || return 1
  sudo env MIPILOT_POLICY_NAME="$target" "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval -r '
    .["rules"][]?
    | select(tag == "!!str")
    | split(",")
    | (
        (select((.[-1] | downcase | sub("^\\s+|\\s+$"; "")) == "no-resolve") | .[-2]),
        (select((.[-1] | downcase | sub("^\\s+|\\s+$"; "")) != "no-resolve") | .[-1])
      )
    | sub("^\\s+|\\s+$"; "")
    | sub("^[\"\\x27]|[\"\\x27]$"; "")
    | select(. == strenv(MIPILOT_POLICY_NAME))
  ' "$config_file" | grep -Fqx -- "$target"
}

render_rule_strategy_selection() {
  local input_file="$1"
  local output_file="$2"
  local source_policy="$3"
  local selected_group="$4"

  [[ -n $source_policy && -n $selected_group ]] || return 1
  [[ $source_policy != *','* && $selected_group != *','* ]] || return 1
  yaml_processor_available || return 1
  if [[ $(config_match_policy "$input_file") != "$source_policy" ]]; then
    echo "MATCH 规则当前未使用策略目标 ${source_policy}, 未修改文件." >&2
    return 1
  fi
  # The input needs sudo; the caller-owned output path intentionally does not.
  # shellcheck disable=SC2024
  sudo env MIPILOT_SOURCE_POLICY="$source_policy" MIPILOT_SELECTED_POLICY="$selected_group" \
    "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval '
      (.["rules"][]?
        | select(tag == "!!str")
        | select((split(",") | .[0] | upcase | sub("^\\s+|\\s+$"; "")) == "MATCH")
        | select((split(",") | .[-1] | sub("^\\s+|\\s+$"; "") | sub("^[\"\\x27]|[\"\\x27]$"; "")) == strenv(MIPILOT_SOURCE_POLICY)))
      |= (split(",") | .[-1] = strenv(MIPILOT_SELECTED_POLICY) | join(","))
    ' "$input_file" >"$output_file"
}

list_rule_selector_names() {
  local config_file="$1"

  comm -12 \
    <(list_config_selector_names "$config_file" | sort -u) \
    <(list_config_rule_policy_names "$config_file" | sort -u)
}

parent_group_has_child() {
  local config_file="$1"
  local parent_name="$2"
  local child_name="$3"

  yaml_processor_available || return 1
  sudo env MIPILOT_PARENT_NAME="$parent_name" MIPILOT_CHILD_NAME="$child_name" \
    "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval -r '
      .["proxy-groups"][]?
      | select(.name == strenv(MIPILOT_PARENT_NAME))
      | .proxies[]?
      | select(. == strenv(MIPILOT_CHILD_NAME))
    ' "$config_file" | grep -Fqx -- "$child_name"
}

prepare_region_overlay() {
  local config_file="$1"
  local state_file="$2"
  local refs_file="$3"
  local definitions_file="$4"
  local code
  local name
  local pattern
  local group_mode
  local exclude_pattern
  local records_file

  : "$config_file"
  : >"$refs_file"
  records_file="$(mktemp /tmp/mihomo-region-records.XXXXXX.json)" || return 1
  : >"$records_file"
  exclude_pattern="$(region_exclude_pattern)"

  while IFS=';' read -r code name pattern group_mode; do
    [[ -z $code || -z $name || -z $pattern ]] && continue
    group_mode="${group_mode:-url-test}"
    case "$group_mode" in
      url-test|fallback|load-balance|select) ;;
      *) group_mode="url-test" ;;
    esac
    jq -cn \
      --arg name "$name" \
      --arg type "$group_mode" \
      --arg filter "(?i)(${pattern})" \
      --arg exclude "(?i)(${exclude_pattern})" '
        {
          name: $name,
          type: $type,
          "include-all-proxies": true,
          filter: $filter,
          "exclude-filter": $exclude,
          "empty-fallback": "REJECT"
        }
        + if $type == "select" then {} else {
            url: "https://cp.cloudflare.com",
            interval: 300,
            lazy: true,
            "expected-status": "200/204"
          } end
        + if $type == "url-test" then {tolerance: 50} else {} end
        + if $type == "load-balance" then {strategy: "consistent-hashing"} else {} end
      ' >>"$records_file" || {
        rm -f -- "$records_file"
        return 1
      }
  done < <(sudo cat "$state_file")

  jq -s '.' "$records_file" >"$definitions_file"
  local status=$?
  rm -f -- "$records_file"
  return "$status"
}

auto_add_region_groups() {
  local response="$1"
  local nodes_file
  local groups_file
  local existing_state
  local candidate_state
  local dedup_state
  local code
  local name
  local pattern
  local old_line
  local count
  local status
  local needs_apply=0
  local added_count=0
  local rules_need_refresh=0

  nodes_file="$(mktemp /tmp/mihomo-region-nodes.XXXXXX)" || return
  groups_file="$(mktemp /tmp/mihomo-region-groups.XXXXXX)" || {
    rm -f -- "$nodes_file"
    return 1
  }
  existing_state="$(mktemp /tmp/mihomo-region-existing.XXXXXX)" || {
    rm -f -- "$nodes_file" "$groups_file"
    return 1
  }
  candidate_state="$(mktemp /tmp/mihomo-region-state.XXXXXX)" || {
    rm -f -- "$nodes_file" "$groups_file" "$existing_state"
    return 1
  }
  dedup_state="$(mktemp /tmp/mihomo-region-state-dedup.XXXXXX)" || {
    rm -f -- "$nodes_file" "$groups_file" "$existing_state" "$candidate_state"
    return 1
  }
  jq -r '
    .proxies
    | to_entries[]
    | select(.value.all == null)
    | select(.key != "DIRECT" and .key != "REJECT" and .key != "PASS")
    | select(
        (.value.type // "") != "Direct"
        and (.value.type // "") != "Reject"
        and (.value.type // "") != "Pass"
        and (.value.type // "") != "Compatible"
        and (.value.type // "") != "DNS"
      )
    | select(
        .key
        | test("剩余流量|流量剩余|到期时间|过期时间|套餐到期|重置时间|流量重置|Traffic|Expire|Expiration|Bandwidth|Reset"; "i")
        | not
      )
    | .key
  ' <<<"$response" >"$nodes_file"
  jq -r '
    .proxies
    | to_entries[]
    | select(.value.all != null and (.value.all | length) > 0)
    | .key
  ' <<<"$response" >"$groups_file"

  if sudo test -s "$REGION_STATE_FILE"; then
    # shellcheck disable=SC2024
    sudo cat "$REGION_STATE_FILE" >"$existing_state" || {
      rm -f -- "$nodes_file" "$groups_file" "$existing_state" "$candidate_state" "$dedup_state"
      return 1
    }
  fi

  echo "正在扫描订阅中的实际节点..."
  echo
  echo "扫描结果:"
  awk -F';' '$1 ~ /^custom-/ && NF >= 3' "$existing_state" >"$candidate_state"
  while IFS=';' read -r code name pattern group_mode; do
    [[ -z $code || -z $name || -z $pattern ]] && continue

    old_line="$(awk -F';' -v target="$code" '$1 == target { print; exit }' "$existing_state")"
    if [[ -n $old_line ]]; then
      printf '%s\n' "$old_line" >>"$candidate_state"
      continue
    fi

    if grep -Eiq -- "$pattern" "$groups_file"; then
      continue
    fi

    count="$(grep -Eic -- "$pattern" "$nodes_file" || true)"
    if (( count == 0 )); then
      continue
    fi

    printf '  新增 %s: %s 个节点\n' "$name" "$count"
    needs_apply=1
    added_count=$((added_count + 1))
    printf '%s;%s;%s;url-test\n' "$code" "$name" "$pattern" >>"$candidate_state"
  done < <(region_specs)

  awk -F';' 'NF >= 3 && !seen[$1]++' "$candidate_state" >"$dedup_state"
  if [[ -s $dedup_state ]] && ! region_group_rules_current "$CONFIG_FILE" "$dedup_state"; then
    rules_need_refresh=1
    needs_apply=1
    echo "  生成或更新自动策略组的节点筛选规则."
  fi

  if (( needs_apply == 0 )); then
    echo "  自动策略组已完整, 节点筛选规则无需更新."
    rm -f -- "$nodes_file" "$groups_file" "$existing_state" "$candidate_state" "$dedup_state"
    return 0
  fi

  echo
  if (( added_count > 0 )); then
    echo "新增策略组将使用自动测速(url-test), 并加入规则模式可选列表."
  fi
  if (( rules_need_refresh > 0 )); then
    echo "自动策略组将生成或更新节点筛选规则, 并排除流量、到期等提示节点."
  fi
  read_yes_no_or_back "确认生成并应用? [y/N] (Enter=否, Esc返回): " no
  status=$?
  if (( status == 130 )); then
    rm -f -- "$nodes_file" "$groups_file" "$existing_state" "$candidate_state" "$dedup_state"
    return 130
  fi
  if (( status != 0 )); then
    rm -f -- "$nodes_file" "$groups_file" "$existing_state" "$candidate_state" "$dedup_state"
    return 1
  fi
  if [[ $CONFIRM_RESULT != yes ]]; then
    echo "已取消, 配置未改变."
    rm -f -- "$nodes_file" "$groups_file" "$existing_state" "$candidate_state" "$dedup_state"
    return 130
  fi

  apply_region_group_state "$dedup_state" region "地区策略组及筛选规则已更新."
  status=$?
  rm -f -- "$nodes_file" "$groups_file" "$existing_state" "$candidate_state" "$dedup_state"
  return "$status"
}

managed_region_parent() {
  if sudo test -s "$REGION_PARENT_FILE"; then
    sudo head -n 1 "$REGION_PARENT_FILE"
  else
    printf '🚀节点选择\n'
  fi
}

save_region_parent() {
  local parent="$1"
  local temporary

  [[ -n $parent && $parent != *$'\n'* && $parent != *$'\r'* ]] || return 1
  temporary="$(mktemp /tmp/mihomo-region-parent.XXXXXX)" || return 1
  printf '%s\n' "$parent" >"$temporary"
  atomic_install_file 600 "$temporary" "$REGION_PARENT_FILE"
  local status=$?
  rm -f -- "$temporary"
  if (( status == 0 )); then
    sync_mipilot_config_from_state || return 1
  fi
  return "$status"
}

list_rule_parent_candidates() {
  local config_file="$1"
  local candidate
  local candidates=()
  local all_candidates=()

  mapfile -t candidates < <(list_rule_selector_names "$config_file")
  if (( ${#candidates[@]} == 0 )); then
    mapfile -t candidates < <(list_config_selector_names "$config_file")
  fi
  if (( ${#candidates[@]} == 0 )); then
    mapfile -t all_candidates < <(list_config_group_names "$config_file")
    for candidate in "${all_candidates[@]}"; do
      [[ $candidate == "$RULE_SELECTOR_GROUP" || $candidate == "$REGION_MANAGED_PARENT" ]] && continue
      candidates+=("$candidate")
    done
  fi
  (( ${#candidates[@]} > 0 )) && printf '%s\n' "${candidates[@]}"
}

preferred_rule_parent_for_config() {
  local config_file="$1"
  local saved_parent="${2:-}"
  local match_policy
  local candidate
  local preferred
  local candidates=()

  match_policy="$(config_match_policy "$config_file")"
  if [[ -n $match_policy && $match_policy != "$RULE_SELECTOR_GROUP" ]]; then
    printf '%s\n' "$match_policy"
    return 0
  fi
  if [[ $match_policy == "$RULE_SELECTOR_GROUP" && -n $saved_parent ]] &&
     config_has_group "$config_file" "$saved_parent"; then
    printf '%s\n' "$saved_parent"
    return 0
  fi
  mapfile -t candidates < <(list_rule_parent_candidates "$config_file")
  for candidate in "${candidates[@]}"; do
    if [[ -n $saved_parent && $candidate == "$saved_parent" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  for preferred in "🚀节点选择" "节点选择" "代理选择" "Proxy" "手动选择"; do
    for candidate in "${candidates[@]}"; do
      if [[ $candidate == "$preferred" ]]; then
        printf '%s\n' "$candidate"
        return 0
      fi
    done
  done
  if (( ${#candidates[@]} == 1 )); then
    printf '%s\n' "${candidates[0]}"
  fi
}

preferred_default_rule_group_for_config() {
  local config_file="$1"
  local fallback_group="$2"
  local preferred

  if [[ $fallback_group == DIRECT || $fallback_group == REJECT || $fallback_group == PASS ]]; then
    printf '%s\n' "$fallback_group"
    return 0
  fi
  config_has_group "$config_file" "$fallback_group" || return 1
  for preferred in "🚀节点选择" "节点选择" "代理选择" "Proxy" "手动选择"; do
    if [[ $fallback_group == "$preferred" ]] ||
       parent_group_has_child "$config_file" "$fallback_group" "$preferred"; then
      printf '%s\n' "$preferred"
      return 0
    fi
  done
  printf '%s\n' "$fallback_group"
}

ensure_region_parent() {
  local response="$1"
  local config_file="${2:-$CONFIG_FILE}"
  local saved_parent
  local preferred
  local candidate
  local candidates=()

  REGION_PARENT=""
  saved_parent="$(managed_region_parent)"
  mapfile -t candidates < <(list_rule_selector_names "$config_file")
  if [[ -n $saved_parent ]] &&
     { jq -e --arg parent "$saved_parent" '.proxies[$parent].all != null' <<<"$response" >/dev/null ||
       [[ $saved_parent == DIRECT || $saved_parent == REJECT || $saved_parent == PASS ]]; }; then
    REGION_PARENT="$saved_parent"
    return 0
  fi
  for candidate in "${candidates[@]}"; do
    if [[ $candidate == "$saved_parent" ]] &&
       jq -e --arg parent "$candidate" '.proxies[$parent].type == "Selector"' <<<"$response" >/dev/null; then
      REGION_PARENT="$saved_parent"
      return 0
    fi
  done
  if (( ${#candidates[@]} == 0 )); then
    REGION_PARENT="$(config_match_policy "$config_file")"
    [[ -n $REGION_PARENT ]] || {
      echo "当前配置没有可识别的规则策略目标."
      return 1
    }
    return 0
  fi
  for preferred in "🚀节点选择" "节点选择" "代理选择" "Proxy" "手动选择"; do
    for candidate in "${candidates[@]}"; do
      if [[ $candidate == "$preferred" ]]; then
        REGION_PARENT="$candidate"
        break 2
      fi
    done
  done
  if [[ -z $REGION_PARENT && ${#candidates[@]} == 1 ]]; then
    REGION_PARENT="${candidates[0]}"
  fi
  if [[ -z $REGION_PARENT ]]; then
    echo "无法自动判断订阅的主要规则出口."
    echo "请选择一个接收主要规则流量的策略组; 后续可以在节点管理中切换实际策略."
    choose_item "选择订阅的主要规则出口:" "${candidates[@]}" || return
    REGION_PARENT="$SELECTED"
  fi
}

apply_region_group_state() {
  local candidate_state="$1"
  local reason="$2"
  local success_message="$3"
  local base_config="${4:-$CONFIG_FILE}"
  local temporary_config
  local selector_config
  local backup
  local status
  local parent
  local previous_state
  local had_state=0
  local was_active=0

  runtime_is_active && was_active=1

  temporary_config="$(mktemp /tmp/mihomo-region-config.XXXXXX.yaml)" || return 1
  if ! apply_region_groups_to_config "$base_config" "$temporary_config" "$candidate_state"; then
    rm -f -- "$temporary_config"
    echo "无法安全合并地区策略组, 现有配置未改变."
    return 1
  fi
  parent="$(sudo jq -r '.rule_selection.parent // empty' "$MANAGER_CONFIG_FILE" 2>/dev/null || true)"
  [[ -n $parent ]] || parent="$(managed_region_parent)"
  selector_config="$(mktemp /tmp/mihomo-rule-selector-apply.XXXXXX.yaml)" || {
    rm -f -- "$temporary_config"
    return 1
  }
  if ! apply_rule_selector_to_config "$temporary_config" "$selector_config" "$parent"; then
    rm -f -- "$temporary_config" "$selector_config"
    echo "无法生成 MiPilot 规则选择策略组, 现有配置未改变."
    return 1
  fi
  mv -f -- "$selector_config" "$temporary_config"
  run_cancellable_named "正在验证地区策略组配置" 45 \
    sudo -n "$MIHOMO_BIN" -t -d "$CONFIG_DIR" -f "$temporary_config"
  status=$?
  if (( status != 0 )); then
    rm -f -- "$temporary_config"
    (( status == 130 )) && return 130
    echo "地区策略组配置验证失败, 现有配置未改变."
    return 1
  fi
  backup="$(create_config_backup "$reason")" || {
    rm -f -- "$temporary_config"
    return 1
  }
  previous_state="$(mktemp /tmp/mihomo-region-state-previous.XXXXXX)" || {
    rm -f -- "$temporary_config"
    return 1
  }
  if sudo test -f "$REGION_STATE_FILE"; then
    had_state=1
    copy_privileged_file_to_temp "$REGION_STATE_FILE" "$previous_state" || {
      rm -f -- "$temporary_config"
      sudo rm -f -- "$previous_state"
      return 1
    }
  fi
  if ! atomic_install_file 600 "$candidate_state" "$REGION_STATE_FILE" || ! sync_mipilot_config_from_state; then
    restore_optional_managed_file "$previous_state" "$had_state" "$REGION_STATE_FILE" || true
    sync_mipilot_config_from_state || true
    sudo rm -f -- "$previous_state"
    rm -f -- "$temporary_config"
    echo "无法保存自定义策略组状态, 现有配置未改变."
    return 1
  fi
  atomic_install_file 600 "$temporary_config" "$CONFIG_FILE" || {
    restore_optional_managed_file "$previous_state" "$had_state" "$REGION_STATE_FILE" || true
    sync_mipilot_config_from_state || true
    sudo rm -f -- "$previous_state"
    rm -f -- "$temporary_config"
    return 1
  }
  rm -f -- "$temporary_config"
  if ! apply_runtime_config_if_active "$was_active" 2; then
    if rollback_config "$backup" "$was_active"; then
      restore_optional_managed_file "$previous_state" "$had_state" "$REGION_STATE_FILE" || true
      sync_mipilot_config_from_state || true
    else
      echo "严重错误: 地区策略组配置回滚未完成, 已保留与当前配置对应的新状态."
    fi
    sudo rm -f -- "$previous_state"
    echo "地区策略组应用失败, 已尝试恢复原配置."
    return 1
  fi
  sudo rm -f -- "$previous_state"
  refresh_api_config
  if (( was_active == 1 )); then
    restore_mipilot_selections || echo "警告: 策略组配置已生效, 但保存的运行选择未能完全恢复."
  fi
  echo "$success_message"
  (( was_active == 0 )) && echo "Mihomo 当前未运行, 新配置将在下次启动时生效."
  echo "备份文件: ${backup}"
}

select_managed_region_record() {
  local prompt="$1"
  local record
  local names=()

  SELECTED_REGION_RECORD=""
  sudo test -s "$REGION_STATE_FILE" || {
    echo "尚未创建 MiPilot 自定义策略组."
    return 1
  }
  while IFS= read -r record; do
    IFS=';' read -r _ name _ _ <<<"$record"
    [[ -n $name ]] && names+=("$name")
  done < <(sudo cat "$REGION_STATE_FILE")
  (( ${#names[@]} > 0 )) || return 1
  choose_item "$prompt" "${names[@]}" || return
  SELECTED_REGION_RECORD="$(sudo awk -F';' -v target="$SELECTED" '$2 == target { print; exit }' "$REGION_STATE_FILE")"
  [[ -n $SELECTED_REGION_RECORD ]]
}

view_managed_region_group_nodes() {
