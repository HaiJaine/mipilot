    echo "================ 策略组管理 =================="
    show_managed_region_groups
    cat <<'EOF'

 1) 按地区自动创建常用策略组
 2) 创建自定义策略组(可组合地区)
 3) 查看策略组匹配节点
 4) 修改策略组类型
 5) 删除自定义策略组
 0) 返回主菜单
================================================
EOF
    read_choice_or_back "请选择编号后按 Enter (Esc/0 返回): " || return 130
    choice="$MENU_CHOICE"
