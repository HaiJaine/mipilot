  local name
  local group_type

  select_managed_region_record "选择要查看的 MiPilot 策略组:" || return
  IFS=';' read -r _ name _ _ <<<"$SELECTED_REGION_RECORD"
  if ! jq -e --arg name "$name" '.proxies[$name].all != null' <<<"$response" >/dev/null; then
    echo "当前运行配置中找不到策略组 ${name}, 请重新应用自定义策略组."
    return 1
