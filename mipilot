  echo "当前节点: $(jq -r --arg name "$name" '.proxies[$name].now // "自动"' <<<"$response")"
  echo "匹配节点:"
  jq -r --arg name "$name" '.proxies[$name].all[]? | "  - " + .' <<<"$response"
}

warn_empty_managed_region_groups_from_config() {
  local config_file="$1"
  local nodes_file
  local name
  local pattern
  local exclude_pattern
  local provider_count
  local empty_count=0

  yaml_processor_available || return 0
  nodes_file="$(mktemp /tmp/mihomo-region-config-nodes.XXXXXX)" || return 1
  if ! sudo "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval -r '.proxies[]?.name // ""' \
       "$config_file" | sed '/^$/d' >"$nodes_file"; then
    rm -f -- "$nodes_file"
    return 0
  fi
  provider_count="$(sudo "$YQ_BIN" --yaml-fix-merge-anchor-to-spec eval -r \
    '(."proxy-providers" // {}) | length' "$config_file" 2>/dev/null || printf '0')"
  [[ $provider_count =~ ^[0-9]+$ ]] || provider_count=0
  exclude_pattern="$(region_exclude_pattern)"

  while IFS=';' read -r _ name pattern _; do
    [[ -n $name && -n $pattern ]] || continue
    if grep -Ei -- "$pattern" "$nodes_file" | grep -Eiv -- "$exclude_pattern" >/dev/null; then
      continue
    fi
    if (( provider_count > 0 )); then
      echo "提示: 自定义策略组 ${name} 的节点来自代理提供者, Mihomo 停止时无法离线确认匹配结果."
    else
      echo "警告: 自定义策略组 ${name} 在新订阅中没有匹配节点, 该组当前会回退到 REJECT."
      empty_count=$((empty_count + 1))
    fi
  done < <(sudo cat "$REGION_STATE_FILE")
  rm -f -- "$nodes_file"
  (( empty_count == 0 ))
}

warn_empty_managed_region_groups() {
  local response
  local name
  local empty_count=0

  sudo test -s "$REGION_STATE_FILE" || return 0
  if ! runtime_is_active || [[ -z $API ]]; then
    warn_empty_managed_region_groups_from_config "$CONFIG_FILE"
    return $?
  fi
  response="$(api_quick "${API}/proxies")" || {
    warn_empty_managed_region_groups_from_config "$CONFIG_FILE"
    return $?
  }
  while IFS=';' read -r _ name _ _; do
    [[ -n $name ]] || continue
    if ! jq -e --arg name "$name" '.proxies[$name].all != null and (.proxies[$name].all | length) > 0' <<<"$response" >/dev/null; then
      echo "警告: 自定义策略组 ${name} 在新订阅中没有匹配节点, 该组当前会回退到 REJECT."
      empty_count=$((empty_count + 1))
    fi
  done < <(sudo cat "$REGION_STATE_FILE")
  (( empty_count == 0 ))
}

change_managed_region_group_mode() {
  local name
  local group_mode
  local candidate_state
  local status

  select_managed_region_record "选择要修改类型的 MiPilot 策略组:" || return
  IFS=';' read -r _ name _ _ <<<"$SELECTED_REGION_RECORD"
  choose_item "选择新的策略类型:" \
    "自动测速 - 定期检测并选择延迟合适的节点" \
    "故障回退 - 优先节点不可用时自动切换" \
    "负载均衡 - 将不同连接分配到多个节点" \
    "手动选择 - 由用户固定选择组内节点" || return
  case "$SELECTED" in
    自动测速*) group_mode="url-test" ;;
    故障回退*) group_mode="fallback" ;;
    负载均衡*) group_mode="load-balance" ;;
    手动选择*) group_mode="select" ;;
    *) return 1 ;;
  esac
  candidate_state="$(mktemp /tmp/mihomo-region-mode-state.XXXXXX)" || return 1
  # The input needs sudo; the caller-owned output path intentionally does not.
  # shellcheck disable=SC2024
  sudo awk -F';' -v OFS=';' -v target="$name" -v mode="$group_mode" '
    $2 == target { $4 = mode }
    NF >= 3 { print }
  ' "$REGION_STATE_FILE" >"$candidate_state" || {
    rm -f -- "$candidate_state"
    return 1
  }
  apply_region_group_state "$candidate_state" region-mode "策略组类型已更新: ${name}"
