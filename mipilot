check_dependencies() {
  local missing=()
  local command_name

  for command_name in awk curl cut find flock getent groupdel gzip grep ip jq locale sed setsid sha256sum sort stat sudo systemctl timeout tr useradd userdel; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      missing+=("$command_name")
    fi
  done

  if (( ${#missing[@]} > 0 )); then
    echo "缺少命令: ${missing[*]}"
    echo "请先安装缺失依赖."
    return 1
  fi

  if ! yaml_processor_available; then
    echo "缺少 MiPilot 私有 yq v${YQ_VERSION}: ${YQ_BIN}"
    echo "请重新运行完整离线包中的 ./mipilot 进行修复."
    return 1
  fi

  if ! sudo test -f "$CONFIG_FILE"; then
    echo "找不到配置文件: ${CONFIG_FILE}"
    return 1
  fi

  if ! sudo test -x "$MIHOMO_BIN" && ! command -v mihomo >/dev/null 2>&1; then
    echo "找不到 Mihomo 内核: ${MIHOMO_BIN}"
    return 1
  fi
}

run_action() {
