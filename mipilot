pause() {
  local key

  echo
  printf '按 Enter 或 Esc 返回菜单...'
  while true; do
    if ! IFS= read -r -s -n 1 key; then
      echo
      return
    fi

    if [[ -z $key || $key == $'\e' ]]; then
      echo
      return
    fi
  done
}

clear_screen() {
  [[ -t 1 ]] || return 0

  if command -v clear >/dev/null 2>&1 && [[ -n ${TERM:-} && ${TERM:-} != dumb ]]; then
    clear && return 0
  fi
  printf '\033[2J\033[H'
}

ensure_sudo_access() {
  if (( EUID == 0 )); then
    return 0
  elif command -v sudo >/dev/null 2>&1; then
    sudo -v
  else
    echo "当前用户不是root且系统缺少sudo, 无法管理 Mihomo."
    return 1
  fi
}

read_choice_or_back() {
  local prompt="$1"
  local status

  while true; do
    MENU_CHOICE=""
    read_line_or_back "$prompt"
    status=$?
    if (( status == 130 )); then return 1; fi
    if (( status != 0 )); then return 1; fi

    MENU_CHOICE="$(trim_input_whitespace "$INPUT_LINE")"

    if [[ -z $MENU_CHOICE ]]; then
      continue
    fi
    if [[ $MENU_CHOICE =~ ^[0-9]+$ ]]; then
      if (( ${#MENU_CHOICE} > 9 )); then
        MENU_CHOICE="invalid"
      else
        MENU_CHOICE="$((10#$MENU_CHOICE))"
      fi
    fi

    if [[ $MENU_CHOICE == 0 ]]; then
      return 1
    fi
    return 0
  done
}

trim_input_whitespace() {
  local value="$1"

  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

display_text_has_control_characters() {
  local value="$1"

  printf '%s' "$value" | LC_ALL=C grep -q '[[:cntrl:]]'
}

terminal_safe_text() {
  printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177'
}

terminal_safe_output() {
  LC_ALL=C tr -d '\000-\010\013-\037\177'
}

terminal_safe_stdout() {
  if [[ -t 1 ]]; then
    terminal_safe_output
  else
    cat
  fi
}

terminal_safe_stderr() {
  if [[ -t 2 ]]; then
    terminal_safe_output
  else
    cat
  fi
}

require_interactive_terminal() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "交互菜单需要连接终端, 不支持通过管道或重定向提供输入." >&2
    return 1
  fi
}

ensure_utf8_input_locale() {
  local candidate
  local charmap

  charmap="$(locale charmap 2>/dev/null || true)"
  charmap="${charmap^^}"
  if [[ $charmap == UTF-8 || $charmap == UTF8 ]]; then
    return 0
  fi

  for candidate in C.UTF-8 C.utf8 en_US.UTF-8; do
    charmap="$(LC_ALL="$candidate" locale charmap 2>/dev/null || true)"
    charmap="${charmap^^}"
    if [[ $charmap == UTF-8 || $charmap == UTF8 ]]; then
      export LC_ALL="$candidate"
      return 0
    fi
  done

  echo "当前系统缺少可用的 UTF-8 Locale, 无法安全处理中文输入."
  echo "请安装 locales 并启用 C.UTF-8 或 en_US.UTF-8 后重试."
  return 1
}

should_reject_sudo_invocation() {
  local action="$1"
  local effective_uid="$2"

  [[ $effective_uid == 0 ]] || return 1
  [[ -z $action || $action == --install || $action == --menu ]]
}

read_line_or_back() {
  local prompt="$1"
  local character
  local line=""

  INPUT_LINE=""

  if [[ ! -t 0 || ! -t 1 ]]; then
    read -r -p "$prompt" line || return 1
    INPUT_LINE="${line//$'\r'/}"
    return 0
  fi

  printf '%s' "$prompt"
  while true; do
    if ! IFS= read -r -s -n 1 character; then
      echo
      return 1
    fi

    if [[ -z $character ]]; then
      echo
      INPUT_LINE="${line//$'\r'/}"
      return 0
    fi

    case "$character" in
      $'\e')
        echo
        return 130
        ;;
      $'\177'|$'\b')
        if [[ -n $line ]]; then
          line="${line%?}"
          printf '\b \b'
        fi
        ;;
      $'\025')
        while [[ -n $line ]]; do
          line="${line%?}"
          printf '\b \b'
        done
        ;;
      *)
        line+="$character"
        printf '%s' "$character"
        ;;
    esac
  done
}

read_yes_no_or_back() {
  local prompt="$1"
  local default_answer="${2:-no}"
  local answer
  local status

  [[ $default_answer == yes || $default_answer == no ]] || return 1
  CONFIRM_RESULT=""
  while true; do
    read_line_or_back "$prompt"
    status=$?
    if (( status != 0 )); then return "$status"; fi
    answer="$(trim_input_whitespace "$INPUT_LINE")"
    answer="${answer,,}"
    case "$answer" in
      y|yes) CONFIRM_RESULT="yes"; return 0 ;;
      n|no) CONFIRM_RESULT="no"; return 0 ;;
      "") CONFIRM_RESULT="$default_answer"; return 0 ;;
      *) echo "输入无效, 请输入 y 或 n." ;;
    esac
  done
}

run_with_progress() (
  local label="$1"
  local cancellable="$2"
  local timeout_seconds="$3"
  local temporary
  local error_temporary
  local process_id=0
  local key
  local status
  local loop_count=0
  local frame_index=0
  local progress_visible=0
  local timed_out=0
  local started_at=$SECONDS
  local elapsed=0
  local spinner_frames=('|' '/' '-' '\')

  shift 3
  set -m
  umask 077
  temporary="$(mktemp /tmp/mipilot-command.XXXXXX)" || return 1
  error_temporary="$(mktemp /tmp/mipilot-command-error.XXXXXX)" || {
    rm -f -- "$temporary"
    return 1
  }

  clear_progress() {
    if (( progress_visible == 1 )); then
      printf '\r\033[2K\033[?25h' >&2
      progress_visible=0
    fi
  }

  stop_progress_process() {
    local attempt

    (( process_id > 0 )) || return 0
    if kill -0 "$process_id" 2>/dev/null; then
      sudo -n kill -- "-${process_id}" 2>/dev/null || \
        kill -- "-${process_id}" 2>/dev/null || \
        kill "$process_id" 2>/dev/null || true
      for ((attempt = 0; attempt < 20; attempt++)); do
        if ! kill -0 "$process_id" 2>/dev/null; then
          break
        fi
        sleep 0.1
      done
      if kill -0 "$process_id" 2>/dev/null; then
        sudo -n kill -KILL -- "-${process_id}" 2>/dev/null || \
          kill -KILL -- "-${process_id}" 2>/dev/null || \
          kill -KILL "$process_id" 2>/dev/null || true
      fi
    fi
    wait "$process_id" 2>/dev/null || true
  }

  cleanup_progress() {
    clear_progress
    rm -f -- "$temporary" "$error_temporary"
  }

  trap 'stop_progress_process; cleanup_progress; exit 130' HUP INT TERM
  trap 'cleanup_progress' EXIT

  if [[ ! -t 2 ]]; then
    printf '%s...\n' "$label" >&2
  fi

  if declare -F "${1:-}" >/dev/null 2>&1; then
    "$@" >"$temporary" 2>"$error_temporary" &
  else
    setsid "$@" >"$temporary" 2>"$error_temporary" &
  fi
  process_id=$!
  set +m

  while kill -0 "$process_id" 2>/dev/null; do
    ((loop_count++)) || true
    elapsed=$((SECONDS - started_at))
    if (( timeout_seconds > 0 && elapsed >= timeout_seconds )); then
      timed_out=1
      stop_progress_process
      break
    fi

    if (( loop_count >= 3 )) && [[ -t 2 ]]; then
      if (( progress_visible == 0 )); then
        printf '\033[?25l' >&2
      fi
      if [[ $cancellable == true ]]; then
        printf '\r\033[2K%s %s  已等待 %ss, 按 Esc 取消' \
          "$label" "${spinner_frames[$((frame_index % 4))]}" "$elapsed" >&2
      else
        printf '\r\033[2K%s %s  已等待 %ss, 当前阶段不可中断' \
          "$label" "${spinner_frames[$((frame_index % 4))]}" "$elapsed" >&2
      fi
      ((frame_index++)) || true
      progress_visible=1
    fi

    if [[ $cancellable == true && -t 0 ]]; then
      if IFS= read -r -s -n 1 -t 0.1 key && [[ $key == $'\e' ]]; then
        stop_progress_process
        clear_progress
        echo "已取消当前操作." >&2
        trap - EXIT HUP INT TERM
        cleanup_progress
        return 130
      fi
    else
      sleep 0.1
    fi
  done

  if (( timed_out == 1 )); then
    status=124
  else
    wait "$process_id"
    status=$?
  fi
  process_id=0
  clear_progress
  if [[ -t 1 ]]; then
    terminal_safe_stdout <"$temporary"
  else
    cat "$temporary"
  fi
  if [[ -t 2 ]]; then
    terminal_safe_stderr <"$error_temporary" >&2
  else
    cat "$error_temporary" >&2
  fi
  if (( timed_out == 1 )); then
    echo "${label}: 等待超过 ${timeout_seconds}s, 已停止." >&2
  elif [[ ! -t 2 ]]; then
    if (( status == 0 )); then
      echo "${label}: 完成." >&2
    else
      echo "${label}: 失败(状态 ${status})." >&2
    fi
  fi
  trap - EXIT HUP INT TERM
  cleanup_progress
  return "$status"
)

run_cancellable() {
  run_with_progress "处理中" true 0 "$@"
}

run_cancellable_named() {
  local label="$1"
  local timeout_seconds="$2"
  shift 2
  run_with_progress "$label" true "$timeout_seconds" "$@"
}

run_blocking() {
  local label="$1"
  local timeout_seconds="$2"
  shift 2
  run_with_progress "$label" false "$timeout_seconds" "$@"
}

ensure_shell_integration() {
  local bashrc="$SHELL_RC_FILE"
  local temporary

  if [[ -L $bashrc ]]; then
    bashrc="$(readlink -f -- "$bashrc")" || return 1
    [[ -n $bashrc ]] || return 1
  fi

  mkdir -p "$PROXY_STATE_DIR"
  if [[ ! -f $PROXY_STATE_FILE && -f ${USER_HOME}/.config/mihomoctl/proxy-state.sh ]]; then
    cp -p -- "${USER_HOME}/.config/mihomoctl/proxy-state.sh" "$PROXY_STATE_FILE" || return 1
  elif [[ ! -f $PROXY_STATE_FILE && -f ${USER_HOME}/.config/mihomo-manager/proxy-state.sh ]]; then
    cp -p -- "${USER_HOME}/.config/mihomo-manager/proxy-state.sh" "$PROXY_STATE_FILE" || return 1
  fi
  touch "$bashrc"
  temporary="$(mktemp "${bashrc}.XXXXXX")" || return

  awk \
    -v block_begin="$SHELL_INTEGRATION_BEGIN" \
    -v block_end="$SHELL_INTEGRATION_END" \
    -v old_begin="$LEGACY_MIHOMOCTL_BEGIN" \
    -v old_end="$LEGACY_MIHOMOCTL_END" \
    -v legacy="$LEGACY_SHELL_INTEGRATION_MARKER" '
      $0 == block_begin || $0 == old_begin { skip = 1; next }
      skip && ($0 == block_end || $0 == old_end) { skip = 0; next }
      $0 == legacy { legacy_left = 6; next }
      legacy_left > 0 { legacy_left--; next }
      !skip { print }
    ' "$bashrc" >"$temporary" || {
      rm -f -- "$temporary"
      return 1
    }

  {
    cat "$temporary"
    printf '\n%s\n' "$SHELL_INTEGRATION_BEGIN"
    printf 'if [ -f "$HOME/.config/mipilot/proxy-state.sh" ]; then\n'
    printf '  . "$HOME/.config/mipilot/proxy-state.sh"\n'
    printf 'fi\n'
    printf 'mipilot() {\n'
    printf '  source "%s" --menu\n' "$MANAGER_INSTALLED_SCRIPT"
    printf '}\n'
    printf '%s\n' "$SHELL_INTEGRATION_END"
  } >"${temporary}.new"
  chmod --reference="$bashrc" "${temporary}.new" 2>/dev/null || chmod 600 "${temporary}.new"
  if cmp -s -- "${temporary}.new" "$bashrc"; then
    rm -f -- "$temporary" "${temporary}.new"
    return 0
  fi
  mv -f -- "${temporary}.new" "$bashrc"
  rm -f -- "$temporary"
}

remove_shell_integration() {
  local bashrc="$SHELL_RC_FILE"
  local temporary

  if [[ -L $bashrc ]]; then
    bashrc="$(readlink -f -- "$bashrc")" || return 1
    [[ -n $bashrc ]] || return 1
  fi

  [[ -f $bashrc ]] || return 0
  temporary="$(mktemp "${bashrc}.XXXXXX")" || return
  awk \
    -v block_begin="$SHELL_INTEGRATION_BEGIN" \
    -v block_end="$SHELL_INTEGRATION_END" \
    -v old_begin="$LEGACY_MIHOMOCTL_BEGIN" \
    -v old_end="$LEGACY_MIHOMOCTL_END" \
    -v legacy="$LEGACY_SHELL_INTEGRATION_MARKER" '
      $0 == block_begin || $0 == old_begin { skip = 1; next }
      skip && ($0 == block_end || $0 == old_end) { skip = 0; next }
      $0 == legacy { legacy_left = 6; next }
      legacy_left > 0 { legacy_left--; next }
      !skip { print }
    ' "$bashrc" >"$temporary" || {
      rm -f -- "$temporary"
      return 1
  }
  chmod --reference="$bashrc" "$temporary" 2>/dev/null || true
  if cmp -s -- "$temporary" "$bashrc"; then
    rm -f -- "$temporary"
    return 0
  fi
  mv -f -- "$temporary" "$bashrc"
}

mipilot() {
