toggle_service_state() {
  local status=0

  ensure_sudo_access || return 1
  if runtime_is_active; then
    stop_mihomo_with_progress || status=$?
  else
    if ! start_mihomo_with_progress || ! wait_mihomo_with_progress 2; then
      status=1
    else
      refresh_api_config
      if ! restore_mipilot_selections; then
        echo "Mihomo 已启动, 但保存的节点或策略组选择未能完全恢复."
        status=1
      fi
    fi
  fi
  echo "当前状态: $(runtime_status_label)"
