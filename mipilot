switch_runtime_mode() {
  local current_mode
  local current_version

  ensure_sudo_access || return 1
  current_mode="$(installed_runtime_mode)"
  current_version="$(current_core_version)"
  run_blocking "正在验证 Mihomo 配置" 45 sudo -n "$MIHOMO_BIN" -t -d "$CONFIG_DIR" || return 1
  save_component_rollback service || return 1

  if [[ $current_mode == manual ]]; then
    [[ -d /run/systemd/system ]] || {
      echo "当前系统未使用 systemd, 无法切换为系统服务."
      return 1
    }
    manual_stop || return 1
    if ! write_service_unit || ! sudo systemctl daemon-reload || \
       ! install_manager_files service || \
       ! sudo systemctl enable --now mihomo || \
       ! wait_for_mihomo_stable 3 "$current_version"; then
      sudo systemctl disable --now mihomo >/dev/null 2>&1 || true
      restore_component_rollback service || true
      sudo systemctl daemon-reload || true
      restore_manual_runtime_permissions || true
      remove_managed_service_account || true
      install_manager_files manual || true
      echo "切换系统服务失败, 已恢复手动模式."
      return 1
    fi
    echo "已切换为 systemd 服务模式并设置开机启动."
  else
    if ! sudo systemctl disable --now mihomo; then
      echo "无法停止并禁用 Mihomo 服务, 未切换运行模式."
      return 1
    fi
    if ! sudo rm -f -- "$SERVICE_FILE" || ! sudo systemctl daemon-reload || \
       ! install_manager_files manual || \
       ! restore_manual_runtime_permissions || \
       ! remove_managed_service_account; then
      restore_component_rollback service || true
      sudo systemctl daemon-reload || true
      ensure_service_account || true
      ensure_service_runtime_permissions || true
      install_manager_files service || true
      sudo systemctl enable --now mihomo >/dev/null 2>&1 || true
      echo "切换手动模式失败, 已尝试恢复系统服务."
      return 1
    fi
    echo "已切换为手动模式. Mihomo 当前保持停止, 不会开机自启."
  fi
}

redact_sensitive_output() {
  sed -E \
    -e 's#(https?|ss|ssr|vmess|vless|trojan|hysteria2?|tuic|socks5?)://[^[:space:]]+#[REDACTED_URI]#Ig' \
    -e 's#(secret|password|token|authorization)[[:space:]]*[:=][[:space:]]*[^[:space:],}]+#\1=[REDACTED]#Ig' \
    -e 's#(Bearer|Basic)[[:space:]]+[A-Za-z0-9._~+/=-]+#\1 [REDACTED]#Ig'
}

generate_diagnostic_report() {
  local report
  local validation

  report="${USER_HOME}/mihomo-diagnostic-$(date +%Y%m%d-%H%M%S).txt"
  validation="$(sudo "$MIHOMO_BIN" -t -d "$CONFIG_DIR" 2>&1 || true)"
  {
    echo "mipilot Diagnostic"
    echo "generated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "manager_version=${MANAGER_VERSION}"
    echo "kernel_version=$(current_core_version)"
    echo "runtime_mode=$(installed_runtime_mode)"
    echo "runtime_active=$(runtime_is_active && printf true || printf false)"
    echo "tun=$(tun_config_value 2>/dev/null || true)"
    echo "mode=$(config_value mode 2>/dev/null || true)"
    echo "ports:"
    sudo grep -E '^(mixed-port|port|socks-port|external-controller):' "$CONFIG_FILE" 2>/dev/null \
      | sed -E 's#(secret:).*#\1 [REDACTED]#'
    echo "config_validation:"
    printf '%s\n' "$validation" \
      | redact_sensitive_output
    echo "network_compatibility:"
    show_network_compatibility_report | redact_sensitive_output
    echo "recent_logs:"
    if [[ $(installed_runtime_mode) == service ]]; then
      sudo journalctl -u mihomo -n 50 --no-pager 2>/dev/null
    else
      sudo tail -n 50 "$MANUAL_LOG_FILE" 2>/dev/null
    fi | redact_sensitive_output
  } >"$report"
  chmod 600 "$report"
  echo "脱敏诊断报告已保存: ${report}"
}

