    PROXY_URL="http://127.0.0.1:${mixed_port}"
    SOCKS_PROXY_URL="socks5h://127.0.0.1:${mixed_port}"
  fi

  controller="$(config_value external-controller)"
  API_SECRET="$(config_value secret)"

  if [[ -z $controller ]]; then
    API=""
    return
  fi

  controller_host="${controller%:*}"
  controller_port="${controller##*:}"
  if [[ $controller_host != 127.0.0.1 && $controller_host != localhost ]] ||
     [[ ! $controller_port =~ ^[0-9]+$ ]] ||
     (( controller_port < 1 || controller_port > 65535 )); then
