  if sudo -n test -f "$TUN_ROUTING_STATE_FILE"; then
    priority="$(tun_routing_state_value priority)"
    mark="$(tun_routing_state_value mark)"
    echo "旧版路由优先级: ${priority:-读取失败}"
    echo "旧版连接标记: ${mark:-读取失败}"
  fi
  echo
  echo "IPv4 默认路由:"
  ip -4 route show default 2>/dev/null || true
  echo
  echo "IPv6 默认路由:"
  ip -6 route show default 2>/dev/null || true
  echo
  echo "相关网络接口:"
  interfaces="$(list_network_interfaces_by_role || true)"
  if [[ -n $interfaces ]]; then
    printf '%s\n' "$interfaces"
  else
