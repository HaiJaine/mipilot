{
  "command": ["/usr/local/bin/mipilot"],
  "timeout": 300,
  "steps": [
    {
      "expect": "MiPilot 代理管理器",
      "sendline": "3"
    },
    {
      "expect": "选择 MATCH 未匹配流量的默认出口策略组",
