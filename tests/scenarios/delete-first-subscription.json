{
  "command": ["/usr/local/bin/mipilot"],
  "timeout": 120,
  "steps": [
    {
      "expect": "MiPilot 代理管理器",
      "sendline": "2"
    },
    {
      "expect": "================ 订阅管理 ================",
      "sendline": "3"
    },
    {
      "expect": "请选择订阅编号后按 Enter",
      "sendline": "1"
    },
    {
      "expect_exact": "确认删除该订阅? [y/N] (Enter=否, Esc返回): ",
      "sendline": "y"
    },
    {
      "expect_exact": "订阅地址已删除."
    },
    {
      "expect": "按 Enter 或 Esc 返回菜单",
      "sendline": ""
    },
    {
      "expect": "================ 订阅管理 ================",
      "sendline": "0"
    },
    {
      "expect": "MiPilot 代理管理器",
      "sendline": "0"
    },
    {
      "expect_eof": true
    }
  ]
}
